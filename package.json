{
    "name": "playcanvas-project",
    "version": "0.0.0",
    "private": true,
    "description": "A PlayCanvas Web Components project",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev --open",
        "fmt": "vp fmt --check .",
        "fmt:fix": "vp fmt .",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "start": "vp preview --open",
        "typecheck": "tsc --noEmit",
        "prepare": "vp config"
    },
    "dependencies": {
        "@playcanvas/web-components": "catalog:",
        "playcanvas": "catalog:"
    },
    "devDependencies": {
        "@playcanvas/inspector": "catalog:",
        "skills": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
